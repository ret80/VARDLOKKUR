{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome (launch with debug)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000/VARDLOKKUR/",
      "webRoot": "${workspaceFolder}/src",
      "runtimeExecutable": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
      "userDataDir": "/tmp/vardlokkur-chrome-debug-profile"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Electron",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron",
      "args": ["${workspaceFolder}/main.cjs"],
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "http://localhost:3000"
      }
    }
  ]
}
