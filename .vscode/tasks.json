{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite: Dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "external",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^.*Local:.*http://localhost:3000.*$"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
